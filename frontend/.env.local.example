# NEXA — frontend environment.
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored and must stay that way. If a service account ever
# reaches a commit, rotate it immediately and tell the team
# (IMPLEMENTATION_PLAN.md §2.3).
#
# Every value below is optional. With none of them set the app still runs:
# auth is switched off, the route gate is inert, and the dashboard streams
# frames exactly as it does today. Filling them in turns each feature on.
#
# COPY this file — do not rename it. It is the only committed record of what
# every variable is for, and `mv`-ing it into place deletes that record.
#
# ── Fill the Firebase block in BOTH halves, or neither ─────────────────────
# The NEXT_PUBLIC_FIREBASE_* values switch on the browser half: the login page,
# the providers, and the route gate. FIREBASE_SERVICE_ACCOUNT switches on the
# server half that verifies the token a route handler is handed.
#
# With only the public half set, sign-in works and the gate works, and then
# every write route answers 503 "FIREBASE_SERVICE_ACCOUNT is not set" and run
# recording stays switched off. That is a deliberate, named failure rather than
# a 500 — but it IS a failure, so fill in both or leave the whole block empty.

# ── The frame stream (FR-41, NFR-9) ────────────────────────────────────────
# Where the browser opens its WebSocket. The browser connects to FastAPI
# directly — Next.js never proxies frame data.
#
# NFR-9: this is a ws:// URL, so the page must be served over http from
# localhost. An https origin (i.e. the Vercel deployment) cannot open it —
# browsers block mixed content — and lib/ws.ts will refuse with an explanation
# rather than retrying forever. The live demo runs from http://localhost:3000.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/stream

# ── Firebase Auth (FR-36) ──────────────────────────────────────────────────
# Firebase console → Project settings → General → "Your apps" → Web app.
# These are public by design; they identify the project, they do not authorise
# anything. Enable Email/Password and Google under Authentication → Sign-in
# method, or those buttons will fail with auth/operation-not-allowed.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (FR-37) ─────────────────────────────────────────────────
# Server-side token verification. Firebase console → Project settings →
# Service accounts → "Generate new private key", then collapse the downloaded
# JSON onto ONE line and paste it here.
#
# This one IS a credential: it is full admin access to the project, not read
# access. It is never NEXT_PUBLIC_, never logged, and never committed.
FIREBASE_SERVICE_ACCOUNT=

# ── MongoDB Atlas (FR-38, FR-39, FR-40) ────────────────────────────────────
# Atlas → Connect → Drivers. Database `avr25d`. Also a credential.
MONGODB_URI=
MONGODB_DB=avr25d
