.DS_Store

# tools/ has no package of its own; importing export_onnx from finetune.py
# leaves a __pycache__ beside it.
__pycache__/
*.py[cod]

# Python virtualenvs — created per-developer, never committed.
.venv/
venv/

# Deployment secrets — see deploy/.env.example
# Ignore every deploy env file, then re-include the (empty) committed template.
deploy/.env*
!deploy/.env.example
