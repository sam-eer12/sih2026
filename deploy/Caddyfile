# AVR-25D edge — TLS termination and the /stream split.
#
# Caddy requests and renews a Let's Encrypt certificate automatically on first
# boot. Nothing to run, no certbot, no cron. It needs three things:
#   1. DOMAIN resolves to this VM's public IP  (A record)
#   2. port 80 reachable from the internet     (HTTP-01 challenge)
#   3. port 443 reachable from the internet    (the actual site)
# Miss any one and you get a site that serves an internal self-signed cert,
# which the browser rejects and which then blocks the wss:// upgrade too.

{$DOMAIN} {
	encode zstd gzip

	# ── The frame stream (FR-41) ──────────────────────────────────────────
	# Straight to FastAPI. Caddy upgrades the connection and then gets out of
	# the way — reverse_proxy detects `Connection: Upgrade` and streams
	# bidirectionally with no buffering.
	#
	# The browser reaches this as wss:// because the page is https and
	# lib/ws.ts:resolveStreamUrl upgrades the scheme for any non-loopback
	# host. That function is what makes a cloud deployment possible at all —
	# NFR-9 rules out an https page opening a plain ws:// socket.
	handle /stream {
		reverse_proxy backend:8000
	}

	# Useful for a smoke test from outside the VM:
	#   curl https://$DOMAIN/health
	handle /health {
		reverse_proxy backend:8000
	}

	# ── Everything else is the Next.js app ────────────────────────────────
	handle {
		reverse_proxy frontend:3000
	}

	# Frames are the bulk of the traffic and they do not pass through here as
	# ordinary responses, so the access log stays small and readable.
	log {
		output stdout
		format console
	}
}
