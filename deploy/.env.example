# AVR-25D deployment environment — TEMPLATE.
#
#     cp deploy/.env.example deploy/.env    # then fill it in
#
# ── NEVER PUT REAL VALUES IN THIS FILE ────────────────────────────────────
# This file is COMMITTED. deploy/.env is not. On 10 Sep 2026 this template was
# found holding a live Firebase service account and a live Atlas URI; it had
# not yet been committed, but nothing except that timing prevented it. If a
# credential ever does reach a commit, rotate it immediately and tell the team
# (IMPLEMENTATION_PLAN §2.3) — deleting the file does not remove it from git
# history.
#
# docker compose reads deploy/.env automatically.

# ── The public hostname ───────────────────────────────────────────────────
# Must already resolve to the VM's public IP before the first `up`, or Caddy
# cannot complete the ACME challenge. A free DuckDNS subdomain is fine:
#   DOMAIN=avr25d.duckdns.org
# No scheme, no port, no trailing slash.
DOMAIN=

# ── Firebase Auth — public by design (FR-36) ──────────────────────────────
# BUILD-TIME. These identify the project; they authorise nothing. Copy from
# frontend/.env.local. Changing any of them requires a rebuild, not a restart.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin — a real credential (FR-37) ────────────────────────────
# RUN-TIME ONLY, never a build arg — build args are readable forever via
# `docker history`. The service-account JSON collapsed onto ONE line. This is
# full admin access to the project, not read access.
FIREBASE_SERVICE_ACCOUNT=

# ── MongoDB Atlas (FR-38, FR-39, FR-40) ───────────────────────────────────
# RUN-TIME ONLY. Atlas → Connect → Drivers. Remember to allow the VM's IP
# under Atlas → Network Access, or every write path times out with a
# server-selection error that looks nothing like a firewall problem.
MONGODB_URI=
MONGODB_DB=avr25d

# NEXT_PUBLIC_WS_URL is deliberately NOT here — docker-compose.yml derives it
# as wss://${DOMAIN}/stream so the two can never disagree. Setting it here has
# no effect on the build.
